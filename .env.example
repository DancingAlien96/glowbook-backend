# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database — matches docker-compose.yml
DATABASE_URL="mysql://glowbook:glowbook@localhost:3306/glowbook"

# JWT — replace with strong random strings (>= 32 chars) in production
JWT_ACCESS_SECRET=change-me-access-supersecret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-supersecret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Email — Resend (https://resend.com)
# CRITICAL: Must be configured for emails to work
# 1. Sign up at https://resend.com (free tier available)
# 2. Get your API key from https://resend.com/api-keys
# 3. For production, add and verify your domain at https://resend.com/domains
RESEND_API_KEY=re_your_api_key_here
# For development: use onboarding@resend.dev (test email)
# For production: use your verified domain (e.g., noreply@yourdomain.com)
EMAIL_FROM="Ecodama <noreply@yourdomain.com>"
# Public URL of the frontend — used in email links
APP_URL=http://localhost:3000

# Recurrente payment gateway
# Get these from https://app.recurrente.com → Configuración → Llaves API
# SECRET key powers the API checkout flow (creates a checkout mapped to the salon
# so activation is reliable regardless of the email the customer types).
RECURRENTE_SECRET_KEY=sk_live_your_secret_key_here
# Optional — only if your account also requires the public key header.
RECURRENTE_PUBLIC_KEY=
RECURRENTE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Static product links — used ONLY as a fallback if the API checkout fails.
RECURRENTE_SUBSCRIPTION_URL=https://app.recurrente.com/s/arcadiasolutions/plan-monthly
RECURRENTE_YEARLY_URL=https://app.recurrente.com/s/arcadiasolutions/suscripcion-anual-ecodama
RECURRENTE_LIFETIME_URL=https://app.recurrente.com/s/arcadiasolutions/plan-lifetime-ecodama
