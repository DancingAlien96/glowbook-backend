// Glowbook — Prisma schema
// MySQL via docker-compose. Run: npm run db:up && npm run prisma:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================
// Identity
// =========================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(OWNER)
  // Tenant this user belongs to. Null only for global ADMIN.
  salonId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon             Salon?              @relation("SalonMembers", fields: [salonId], references: [id], onDelete: Cascade)
  stylist           Stylist?            @relation("StylistUser")
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]

  @@index([salonId, role])
}

enum UserRole {
  OWNER
  STYLIST
  STAFF
  ADMIN
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  ipAddress String?  @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================
// Tenant: Salon
// =========================
model Salon {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  tagline          String?  @db.VarChar(160)         // Short subtitle under the salon name
  description      String?  @db.Text
  coverImageUrl    String?  @db.VarChar(500)         // Hero background on the public page
  brandColor       String   @default("#D89888") @db.VarChar(9) // Hex, used as accent on the public page
  timezone         String   @default("America/Guayaquil")
  currency         String   @default("USD") @db.VarChar(8)
  depositMode      DepositMode @default(PERCENTAGE)
  depositPercent   Int      @default(30) // 0-100
  approvalMode     ApprovalMode @default(MANUAL)
  bankDetails      String?  @db.Text // free text shown in transfer step
  // Landing-page content — public marketing section, separate from the
  // short `tagline`/`description` used near the hero.
  aboutText        String?  @db.Text                 // "Quiénes somos" — longer story/philosophy
  instagramUrl     String?  @db.VarChar(300)
  facebookUrl      String?  @db.VarChar(300)
  whatsappContact  String?  @db.VarChar(40)           // Business contact number, distinct from a client's own phone
  address          String?  @db.VarChar(300)          // Human-readable label shown on the public page — auto-filled from the map pin, editable
  latitude         Float?                             // GPS pin dropped in the dashboard's map picker, not typed
  longitude        Float?
  contactEmail     String?  @db.VarChar(200)          // Public contact email, distinct from any owner's login email
  contactPhone     String?  @db.VarChar(40)            // Landline/phone for a tel: link, distinct from whatsappContact
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members       User[]         @relation("SalonMembers")
  services      Service[]
  stylists      Stylist[]
  businessHours BusinessHour[]
  blockedSlots  BlockedSlot[]
  clients       Client[]
  appointments  Appointment[]
  payments      Payment[]
  subscription  Subscription?
  photos        SalonPhoto[]
  testimonials  Testimonial[]
}

// Portfolio gallery shown on the public booking page — the dueña uploads a
// handful of work photos to sell the salon visually, not just via text.
model SalonPhoto {
  id        String   @id @default(cuid())
  salonId   String
  url       String   @db.VarChar(500)
  caption   String?  @db.VarChar(160)
  createdAt DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
}

// Testimonials shown on the public page — written/pasted by the dueña
// herself; there's no client-facing review-collection flow (yet).
model Testimonial {
  id          String   @id @default(cuid())
  salonId     String
  clientName  String   @db.VarChar(120)
  text        String   @db.Text
  rating      Int      // 1-5
  serviceName String?  @db.VarChar(120)
  createdAt   DateTime @default(now())

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, createdAt])
}

enum DepositMode {
  NONE
  PERCENTAGE
  FULL
}

enum ApprovalMode {
  MANUAL
  AUTOMATIC
}

// =========================
// Catalog
// =========================
model Service {
  id            String  @id @default(cuid())
  salonId       String
  name          String
  description   String? @db.Text
  category      String? @db.VarChar(64)
  durationMin   Int
  priceCents    Int
  active        Boolean @default(true)
  imageUrl      String? @db.VarChar(500) // Shown on the public page's service cards
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salon        Salon              @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylists     StylistService[]
  appointments AppointmentService[]

  @@index([salonId, active])
}

model Stylist {
  id        String  @id @default(cuid())
  salonId   String
  // Optional link to a User account so the stylist can log in to the portal.
  userId    String? @unique
  name      String
  role      String? @db.VarChar(128)
  photoUrl  String? @db.VarChar(500) // Shown on the public page's "Equipo" section
  active    Boolean @default(true)
  // Percentage of the service price that goes to the stylist on COMPLETED
  // appointments. 0 = no commission tracked, 100 = full price. The dueña
  // edits this from /dashboard/team. Used by /dashboard/commissions.
  commissionPercent Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user         User?            @relation("StylistUser", fields: [userId], references: [id], onDelete: SetNull)
  services     StylistService[]
  appointments Appointment[]
  blockedSlots BlockedSlot[]
  hours        StylistHour[]

  @@index([salonId, active])
}

// Optional per-stylist weekly schedule. If a stylist has no rows here,
// she inherits the salon's BusinessHour. A day can have more than one row
// (e.g. 09:00-13:00 and 15:00-19:00 for a lunch break) — that's why
// dayOfWeek is only indexed, not unique.
model StylistHour {
  id        String @id @default(cuid())
  stylistId String
  dayOfWeek Int    // 0=Sun ... 6=Sat
  openMin   Int
  closeMin  Int

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  // Kept alongside the composite index below — MySQL wouldn't let the
  // migration drop this one in the same transaction that adds the
  // composite index (InnoDB requires an existing *committed* index to
  // keep covering the stylistId foreign key), so it just stays.
  @@index([stylistId])
  @@index([stylistId, dayOfWeek])
}

model StylistService {
  stylistId String
  serviceId String

  stylist Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([stylistId, serviceId])
}

// =========================
// Availability
// =========================
// A day can have more than one row (e.g. 09:00-13:00 and 15:00-19:00 for a
// lunch break) — that's why dayOfWeek is only indexed, not unique.
model BusinessHour {
  id        String @id @default(cuid())
  salonId   String
  dayOfWeek Int    // 0=Sun ... 6=Sat
  openMin   Int    // minutes from 00:00
  closeMin  Int

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  // Kept alongside the composite index below — MySQL wouldn't let the
  // migration drop this one in the same transaction that adds the
  // composite index (InnoDB requires an existing *committed* index to
  // keep covering the salonId foreign key), so it just stays.
  @@index([salonId])
  @@index([salonId, dayOfWeek])
}

model BlockedSlot {
  id        String   @id @default(cuid())
  salonId   String
  stylistId String?  // null = blocks the whole salon
  startAt   DateTime
  endAt     DateTime
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  stylist Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)

  @@index([salonId, startAt])
  @@index([stylistId, startAt])
}

// =========================
// Clients
// =========================
model Client {
  id        String  @id @default(cuid())
  salonId   String
  name      String
  email     String?
  phone     String?
  notes     String? @db.Text
  tag       ClientTag @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([salonId, email])
  @@index([salonId])
}

enum ClientTag {
  NEW
  RETURNING
  VIP
}

// =========================
// Appointments
// =========================
model Appointment {
  id           String   @id @default(cuid())
  salonId      String
  stylistId    String?
  clientId     String
  startAt      DateTime
  endAt        DateTime
  // Totals aggregated across every service on this appointment (see
  // AppointmentService below). Kept as flat columns so commission/earnings
  // math and reporting don't need to re-sum the join table each time.
  durationMin  Int
  priceCents   Int
  depositCents Int      @default(0)
  status       AppointmentStatus @default(PENDING)
  notes        String?  @db.Text
  // Push reminder bookkeeping — set when the "30 min before" push fires so the
  // cron doesn't notify twice for the same appointment.
  reminderSentAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salon    Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services AppointmentService[]
  stylist  Stylist?            @relation(fields: [stylistId], references: [id], onDelete: SetNull)
  client   Client              @relation(fields: [clientId], references: [id])
  payments Payment[]

  @@index([salonId, startAt])
  @@index([stylistId, startAt])
  @@index([clientId])
  @@index([status])
  @@index([status, reminderSentAt, startAt])
}

// One row per service chosen on an appointment. priceCents/durationMin are
// snapshotted at booking time so a later edit to Service pricing doesn't
// retroactively change past appointments.
model AppointmentService {
  appointmentId String
  serviceId     String
  priceCents    Int
  durationMin   Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@id([appointmentId, serviceId])
  @@index([serviceId])
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// =========================
// Payments
// =========================
model Payment {
  id            String   @id @default(cuid())
  salonId       String
  appointmentId String
  amountCents   Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING_REVIEW)
  receiptUrl    String?  @db.VarChar(500)
  receiptName   String?  @db.VarChar(255)
  reference     String?  @db.VarChar(128)
  reviewedAt    DateTime?
  reviewedBy    String?  // userId
  rejectedReason String? @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salon       Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([salonId, status])
  @@index([appointmentId])
}

enum PaymentMethod {
  TRANSFER
  CARD
  CASH
  WALLET
}

enum PaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

// =========================
// Platform billing (super-admin layer)
// =========================
// Singleton row (id = "default") with platform-wide config the admin can edit.
model PlatformSettings {
  id                  String   @id @default("default")
  bankDetails         String?  @db.Text                  // Admin's bank info shown to salon owners
  monthlyPriceCents   Int      @default(2000)            // $20
  yearlyPriceCents    Int      @default(20000)           // $200
  lifetimePriceCents  Int      @default(100000)          // $1,000
  trialDays           Int      @default(14)
  graceDays           Int      @default(7)               // OVERDUE → SUSPENDED after this many days
  contactEmail        String?  @db.VarChar(160)
  contactWhatsapp     String?  @db.VarChar(40)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

// One subscription per salon.
model Subscription {
  id               String       @id @default(cuid())
  salonId          String       @unique
  plan             Plan         @default(MONTHLY)
  status           SubStatus    @default(TRIAL)
  currentPeriodEnd DateTime?    // null for LIFETIME or TRIAL (use trialEndsAt)
  trialEndsAt      DateTime?
  cancelledAt      DateTime?
  trial7DayEmailAt  DateTime?   // set when 7-day warning email is sent
  trial2DayEmailAt  DateTime?   // set when 2-day warning email is sent
  trialExpiredEmailAt DateTime? // set when expiration email is sent
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  salon    Salon                 @relation(fields: [salonId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([status])
  @@index([currentPeriodEnd])
}

enum Plan {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubStatus {
  TRIAL
  ACTIVE
  OVERDUE
  SUSPENDED
  CANCELLED
  LIFETIME
}

model SubscriptionPayment {
  id              String           @id @default(cuid())
  subscriptionId  String
  amountCents     Int
  currency        String           @default("USD") @db.VarChar(8)
  status          SubPaymentStatus @default(PENDING_REVIEW)
  periodMonths    Int              @default(1)            // 1 for monthly, 999 for lifetime
  receiptUrl      String?          @db.VarChar(500)
  receiptName     String?          @db.VarChar(255)
  reference       String?          @db.VarChar(128)
  reviewedAt      DateTime?
  reviewedBy      String?          // admin userId
  rejectedReason  String?          @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([subscriptionId, createdAt])
}

enum SubPaymentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Maps a Recurrente checkout (created via API) back to the salon that started
// it. The webhook uses checkoutId to activate the EXACT account regardless of
// which email the customer typed at Recurrente's checkout page — removing the
// email-matching gotcha of the old static-link flow.
model CheckoutSession {
  id          String   @id @default(cuid())
  checkoutId  String   @unique @db.VarChar(128) // Recurrente "ch_..." id
  salonId     String
  plan        Plan
  amountCents Int
  status      String   @default("PENDING") @db.VarChar(20) // PENDING | COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([salonId])
}

// =========================
// Web Push subscriptions
// =========================
// One row per browser/device that has accepted notifications. We key by the
// endpoint (unique per browser instance) so re-subscribing the same device
// updates the keys instead of creating duplicates. When the push service
// reports the subscription as gone (404/410), we delete the row.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =========================
// Pending activations
// =========================
// Stores Recurrente payment events for users who pay before registering.
// On registration, if a record exists for the email, the subscription is
// activated immediately instead of starting a trial.
model PendingActivation {
  id          String   @id @default(cuid())
  email       String   @unique
  plan        Plan     @default(MONTHLY)
  amountCents Int      @default(2000)
  isTrial     Boolean  @default(false)  // true = subscription.create (card saved, trial started); false = payment received
  reference   String?  @db.VarChar(128)
  createdAt   DateTime @default(now())
}
